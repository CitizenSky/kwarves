<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.koni.astro-data-watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python3</string>
        <string>-u</string>
        <string>/Users/koni/astro_projects/scripts/main/watch_astro_data.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/koni/astro_projects/scripts</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>GIT_TERMINAL_PROMPT</key>
        <string>0</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/koni/astro_projects/logs/astro_data_watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/koni/astro_projects/logs/astro_data_watcher.err.log</string>
</dict>
</plist>
